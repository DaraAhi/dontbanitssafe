{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dontbanitssafe",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "b62bfa34-1ab0-4992-9154-868befb0382b","database_name": "DontBanPlzITSSAFE" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "f8cbdacd842a40d3bd17e8c00aae8aad" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
